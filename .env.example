# Default Browser Agent executor
# The vLLM endpoint is supplied to rbbench with --agent-base-url.
# VLLM_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional private location for lifecycle secrets. Files under the repository's
# session-pools/private directory are ignored by git.
# RBBENCH_SESSION_POOL_DIR=/absolute/private/path/rbbench-session-pools

# Tally trusted setup/grading/cleanup hooks. This token is never supplied to the
# browser agent.
# TALLY_API_TOKEN=
# TALLY_API_TOKEN_FILE=/absolute/private/path/tally-api-token
# TALLY_FORMS_CONFIG=configs/tally/forms.json

# Optional process-level lifecycle overrides. Commands receive
# RBBENCH_CONTEXT_FILE and RBBENCH_OUTPUT_FILE.
# RBBENCH_TALLY_PUBLIC_FORM_PREPARE_CMD=./operator/custom-tally-prepare
# RBBENCH_TALLY_PUBLIC_FORM_OBSERVE_CMD=./operator/custom-tally-observe
# RBBENCH_TALLY_PUBLIC_FORM_CLEANUP_CMD=./operator/custom-tally-cleanup
